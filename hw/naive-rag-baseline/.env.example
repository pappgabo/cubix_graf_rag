# Copy to .env and fill in. .env is git-ignored; never commit real keys.
OPENAI_API_KEY=

# Models (defaults shown)
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Chunking and retrieval (defaults shown). You can also override the chunk
# settings per run: uv run naive-rag ingest --chunk-size 800 --chunk-overlap 120
# CHUNK_SIZE=500
# CHUNK_OVERLAP=75
# TOP_K=4

# Qdrant: leave empty for a local on-disk store (.qdrant/), or point to a server
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
