# Copy to .env and fill in. .env is git-ignored; never commit real keys.
OPENAI_API_KEY=

# Models (defaults shown)
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# Chunking and retrieval (defaults shown). Sizes are characters, not tokens.
# You can also override the chunk settings per run:
#   uv run naive-rag ingest --chunk-size 800 --chunk-overlap 100
# CHUNK_SIZE=1200
# CHUNK_OVERLAP=100
# TOP_K=4

# Local-search context window. Explicit configuration, not a detected
# model capacity. The estimate is ceil(characters / 3), not an exact count.
# CONTEXT_MODEL_WINDOW=8192
# CONTEXT_ANSWER_RESERVE=1024
# CONTEXT_GRAPH_SHARE=0.5

# Extraction call window for gpt-4o-mini. The input window is the whole
# context window; the prompt budget is that minus the output reserve.
# EXTRACTION_INPUT_WINDOW=128000
# EXTRACTION_OUTPUT_RESERVE=16384

# Qdrant: leave empty for a local on-disk store (.qdrant/), or point to a server
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Neo4j (week 2). compose.yaml reads the same variables, so the container and
# the Python driver always agree. Set this only in the untracked .env.
# Neo4j requires at least 8 characters. There is no default password.
NEO4J_PASSWORD=
# NEO4J_USER=neo4j
# NEO4J_URI=bolt://localhost:7687
# NEO4J_DATABASE=neo4j
# Host ports published by compose (change only if 7474/7687 are taken)
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

# Evaluation smoke (measure.py run --smoke). Names only; no secret values.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
